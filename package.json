{
  "name": "kb-cod-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KB COD Manager - formulaires COD Shopify, antifraude, Google Sheets, Meta CAPI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "dev:admin": "vite",
    "build": "npm run build:admin && npm run build:storefront",
    "build:admin": "vite build",
    "build:storefront": "node scripts/build-storefront.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "schema:fetch": "bash scripts/fetch-admin-schema.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/functions": "^1.6.0",
    "css-tree": "^3.2.1",
    "hono": "^4.13.22",
    "libphonenumber-js": "^1.13.17",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.19",
    "@types/css-tree": "^2.3.11",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "graphql": "^16.15.0",
    "happy-dom": "^15.11.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
