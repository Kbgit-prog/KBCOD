{%- comment -%} Données d'amorçage : configuration publiée par l'app + produit courant (prix en centimes). {%- endcomment -%}
{%- assign kb_cfg = app.metafields.kbcod.config.value -%}
{%- if kb_cfg -%}
<script type="application/json" id="kbcod-boot">
{"shop":{{ shop.permanent_domain | json }},"backend":{{ kb_cfg.backend | json }},"config":{{ kb_cfg | json }},
"product":{%- if product -%}{"id":"{{ product.id }}","title":{{ product.title | json }},
"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 | prepend: 'https:' | json }}{% else %}null{% endif %},
"selectedVariantId":"{{ product.selected_or_first_available_variant.id }}",
"variants":[{%- for v in product.variants -%}{"id":"{{ v.id }}","title":{{ v.title | json }},"price":{{ v.price | default: 0 }},
"compareAtPrice":{% if v.compare_at_price > v.price %}{{ v.compare_at_price }}{% else %}null{% endif %},"available":{{ v.available }},
"image":{% if v.image %}{{ v.image | image_url: width: 300 | prepend: 'https:' | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
{%- else -%}null{%- endif -%}}
</script>
<script src="{{ 'kbcod.js' | asset_url }}" defer></script>
{%- endif -%}
