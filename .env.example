# KB COD Manager — variables d'environnement (copier en .env pour le développement local).
# Ne jamais commiter de vraies valeurs. En production : Vercel > Project > Settings > Environment Variables.

# URL publique du serveur (sans / final)
APP_URL=https://kbcod-manager.vercel.app

# PostgreSQL (Supabase : pooler en mode transaction, port 6543, utilisateur kbcod_app.<ref-projet>)
DATABASE_URL=postgresql://kbcod_app.PROJECT_REF:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secrets serveur : générer avec `node scripts/generate-secrets.mjs`
ENCRYPTION_KEY=base64-de-32-octets
HASH_SALT=chaine-aleatoire
CRON_SECRET=chaine-aleatoire-longue

# Application Shopify principale (Dev Dashboard > votre app > Settings)
SHOPIFY_API_KEY=client_id
SHOPIFY_API_SECRET=client_secret
SHOPIFY_API_VERSION=2026-10
# Applications supplémentaires (une app en distribution personnalisée par boutique), JSON :
# [{"clientId":"...","clientSecret":"...","name":"Boutique 2"}]
SHOPIFY_EXTRA_APPS=[]

# Google OAuth (Google Cloud Console > Identifiants > ID client OAuth « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Graph API
META_GRAPH_VERSION=v24.0

# Cloudflare Turnstile (facultatif, gratuit)
TURNSTILE_SECRET=

LOG_LEVEL=info
